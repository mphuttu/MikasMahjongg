BEGIN
    IDR_MAINFRAME "MikasMahjongg\n\nMikasMahjongg\n\n\nMikasMahjongg.Document\nMikasMahjongg.Document"
    AFX_IDS_APP_TITLE "MikasMahjongg"
    AFX_IDS_IDLEMESSAGE "Valmis"
    IDP_OLE_INIT_FAILED "OLE-alustus epäonnistui. Tarkista OLE-kirjastojen versiot."
    ID_FILE_NEW "Aloita uusi peli\nUusi"
    ID_FILE_OPEN "Lataa tallennettu peli\nAvaa"
    ID_FILE_SAVE "Tallenna peli\nTallenna"
    ID_FILE_SAVE_AS "Tallenna peli uudella nimellä\nTallenna nimellä"
    ID_FILE_RESTARTGAME "Aloita sama peli alusta\nAlusta"
    ID_BACKUP_BACKUP "Kumoa viimeinen pari\nKumoa"
    ID_HELP_SHOWMOVES "Näytä mahdollinen pari\nVihje"
    ID_HELP_TILESLEFT "Näytä jäljellä olevien laattojen määrä\nLaattoja jäljellä"
    ID_HELP_RESUFFLE "Sekoita jäljellä olevat laatat\nSekoita"
    ID_HELP_HELPCONTENTS "Avaa peliohje\nOhje"
    ID_SPECIAL_VIEWHALLOFFAME "Näytä nopeimmat voitot\nKunniataulu"
    ID_SPECIAL_CLEARHALLOFFAME "Tyhjennä kunniataulu\nTyhjennä kunniataulu"
    ID_SPECIAL_PAUSE "Pysäytä peli tauolle\nTauko"
    ID_EDIT_UNDO "Kumoa viimeinen siirto\nKumoa"
    ID_EDIT_CUT "Leikkaa valinta\nLeikkaa"
    ID_EDIT_COPY "Kopioi valinta\nKopioi"
    ID_EDIT_PASTE "Liitä leikepöydän sisältö\nLiitä"
    ID_FILE_PRINT "Tulosta peli\nTulosta"
    ID_APP_ABOUT "Näytä ohjelman tiedot\nTietoja"
    ID_APP_EXIT "Lopeta ohjelma\nLopeta"
    ID_VIEW_STATUS_BAR "Näytä tai piilota tilarivi\nTilarivi"
    IDS_TOOLBAR_STANDARD "Vakio"
    IDS_TOOLBAR_CUSTOMIZE "Mukauta..."
    IDS_EDIT_MENU "Muokkaa"
END
